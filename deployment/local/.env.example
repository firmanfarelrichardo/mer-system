APP_NAME="MER System"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta

# ===========================================
# Port Configuration
# ===========================================
APP_PORT=8000
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

# ===========================================
# Proxy & Security
# ===========================================
# '*' = percayai semua proxy (aman untuk Docker network lokal)
# Untuk production, ganti dengan IP spesifik Nginx atau subnet Docker
TRUSTED_PROXIES=*

# ===========================================
# PostgreSQL - Database (Dockerized)
# ===========================================
DB_DATABASE=mer_system
DB_USERNAME=postgres
DB_PASSWORD=secret

# ===========================================
# Redis (Dockerized)
# ===========================================
REDIS_PASSWORD=
