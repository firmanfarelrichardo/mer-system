# ===========================================
# MER System - Production Environment
# ===========================================

APP_NAME="MER System"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta

# IMPORTANT: Generate with `php artisan key:generate --show`
APP_KEY=

# Application URL (adjust to your domain)
# WAJIB menggunakan https:// agar Laravel generate URL yang benar.
APP_URL=https://mers-rsryacudu.com

# Port (default 80 for production — SSL ditangani Cloudflare)
APP_PORT=80

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mer_system
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ===========================================
# Cache, Session & Queue (Redis)
# ===========================================
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis  # Nama service Docker, bukan IP — Docker DNS resolve otomatis
REDIS_PORT=6379
# WAJIB diisi. Gunakan password panjang & acak (min. 32 karakter).
# Generate dengan: openssl rand -base64 32
# JANGAN commit nilai aktualnya ke Git.
REDIS_PASSWORD=

# ===========================================
# Session Security (HTTPS)
# ===========================================
# SESSION_SECURE_COOKIE=true → cookie HANYA dikirim melalui HTTPS.
# Browser akan MENOLAK mengirim session cookie via HTTP biasa,
# mencegah session hijacking melalui koneksi tidak terenkripsi.
SESSION_SECURE_COOKIE=true

# SameSite=Lax → cookie dikirim pada navigasi top-level GET dan
# request same-site. Mencegah CSRF dari situs eksternal.
# Nilai: lax (default aman), strict (lebih ketat), none (tidak disarankan).
SESSION_SAME_SITE=lax

# ===========================================
# Mail Configuration (sesuaikan)
# ===========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===========================================
# CrowdSec (Layer 5 — Intrusion Detection)
# ===========================================
# API key untuk komunikasi Bouncer ↔ CrowdSec Engine.
# Generate dengan:
#   docker exec mer-crowdsec cscli bouncers add nginx-bouncer
# Salin key yang ditampilkan, paste di sini.
CROWDSEC_BOUNCER_API_KEY=

# Port tempat CrowdSec Bouncer mendengarkan traffic publik.
# Ubah jika port 8888 sudah dipakai service lain.
BOUNCER_PORT=8888

# ===========================================
# Monitoring / Observability
# ===========================================
# Password admin Grafana. WAJIB diganti dari default.
# Generate dengan: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
